{
  "name": "Airport Edge AI Demo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "python -m pip install -r airport-edge-platform/backend/requirements-dev.txt && npm --prefix airport-edge-platform/frontend ci",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Airport Edge Dashboard",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8000": {
      "label": "Airport Edge API",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
